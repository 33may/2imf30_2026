% a) A picker never attempts to pick up an item from an empty slot.

forall s: Slot . val(fl(s) < numFloors && sp(s) < slotsPerFloor) =>
  (    [ (!transferPickerToSlot(s))* . transferSlotToPicker(s) ] false
    && [ true* . transferSlotToPicker(s) . (!transferPickerToSlot(s))* . transferSlotToPicker(s) ] false )
