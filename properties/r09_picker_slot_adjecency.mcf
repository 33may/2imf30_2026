% R09. A picker never attempts to place an item in a slot that it is not adjacent to.
forall f: Nat . val(f < numFloors) =>
forall n: Nat . val(n < slotsPerFloor) =>
forall m: Nat . val(m < slotsPerFloor && m != n) =>
    [ true* . movePickerToSlot(slot(f, n)) . !movePickerToSlot(slot(f, m))* . transferPickerToSlot(slot(f, m)) ] false