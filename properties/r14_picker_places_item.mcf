% R14. After receiving an item, the picker eventually places it in the slot assigned to that item, unless an emergency occurs.
forall s : Slot . val(s in AllSlots) =>
    [ true*
        . reserveSlotForNewItem(s)
        . !transferLiftToPicker(fl(s), inputLift)*
        . transferLiftToPicker(fl(s), inputLift) ]
    < !transferPickerToSlot(s)*
        . transferPickerToSlot(s) > true
