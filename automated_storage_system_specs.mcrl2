sort
    % Use a finite struct type for slots and tickets to avoid large state space.
    SlotId = struct s0 | s1 | s2 | s3 ;
	FloorId = struct f0 | f1 | f2;
    Direction = struct input | output;
    Mode = struct normal | emergency;

map
    cap: Nat;
    toFloor: SlotId -> FloorId;
    add_item: SlotId # FSet(SlotId) -> FSet(SlotId);
    remove_item: SlotId # FSet(SlotId) -> FSet(SlotId);

var
    ps: SlotId;
	occupiedSlots: FSet(SlotId);
eqn
    cap = 4;
    toFloor(s0) = f0; toFloor(s1) = f0;
    toFloor(s2) = f1; toFloor(s3) = f1;
%    toFloor(s4) = f2; toFloor(s5) = f2;
    add_item(ps, occupiedSlots) = occupiedSlots + {ps};
    remove_item(ps, occupiedSlots) = occupiedSlots - {ps};

% LIFT CONTROLLER
act
    moveToFloor: Direction # FloorId;
	rcvItemLiftFromPicker, sendItemLiftToPicker, rcvItemLiftFromBuffer, sendItemLiftToBuffer: SlotId;
	itemCollectOK, itemStoreOK, itemStoreKO, itemCollectKO: SlotId;

proc Lift(lt: Direction) = 
	sum sId: SlotId . (
		(lt == output) -> (
		    (toFloor(sId) == f0) -> (
				(itemCollectOK(sId) . rcvItemLiftFromPicker(sId) .	 sendItemLiftToBuffer(sId) . Lift(lt))
				+ (itemCollectKO(sId) . Lift(lt))
			)  <>  (
				(itemCollectOK(sId) . moveToFloor(lt, toFloor(sId)) . rcvItemLiftFromPicker(sId) . moveToFloor(lt, f0). sendItemLiftToBuffer(sId) . Lift(lt))
				+ (itemCollectKO(sId) . Lift(lt))
			)
		) +
		(lt == input) -> (
 			(toFloor(sId) == f0) -> (
				(itemStoreOK(sId) . rcvItemLiftFromBuffer(sId) . sendItemLiftToPicker(sId) . Lift(lt))
				+ ( itemStoreKO(sId) . Lift(lt))
			) <> (
				(itemStoreOK(sId) . rcvItemLiftFromBuffer(sId) . moveToFloor(lt, toFloor(sId)). sendItemLiftToPicker(sId) . moveToFloor(lt, f0) .	Lift(lt))
				+ ( itemStoreKO(sId) . Lift(lt))
			)
		)
	);

% BUFFER CONTROLLER
act
	itemUserInOK,itemUserInKO, itemUserOutKO , itemUserOutOK: SlotId;
	sendItemBufferToLift: SlotId; %the item is destined for this slotId
	rcvItemBufferFromLift: SlotId; %the item is coming from this slotId

proc Buffer(bt: Direction) =
	sum sId: SlotId . (
	    (bt == input) -> (itemUserInOK(sId) . sendItemBufferToLift(sId) . Buffer(bt) + 
									itemUserInKO(sId) . Buffer(bt))
		+
    	(bt == output) -> (itemUserOutOK(sId) . rcvItemBufferFromLift(sId) . Buffer(bt) +
									itemUserOutKO(sId) . Buffer(bt))
	);

% SCANNER CONTROLLER
act scanTicket: SlotId;
	sendItemCollectReq: SlotId;
	rcvItemCollectOK, rcvItemCollectKO: SlotId;

proc Scanner = 
    sum sId: SlotId . scanTicket(sId) . sendItemCollectReq(sId) . (rcvItemCollectOK(sId) + rcvItemCollectKO(sId))  .  Scanner ;

% PRINTER CONTROLLER
act printTicket: SlotId;
    sendItemStoreReq: SlotId;
	rcvItemStoreOK, rcvItemStoreKO: SlotId;
    itemOKPrint, itemKOPrint;

proc Printer =
	 sum sId: SlotId . sendItemStoreReq(sId) .
        ( (rcvItemStoreOK(sId) . printTicket(sId) . Printer) +
          (rcvItemStoreKO(sId) . Printer) );

% PICKER CONTROLLER
act rcvItemPickerFromLift, sendItemPickerToLift, rcvItemCollectCmd, rcvItemStoreCmd: SlotId;
		goToSlot,  storeItemToSlot, collectItemFromSlot: FloorId # SlotId;
		goToInputLift, goToOutputLift: FloorId;

proc Picker(pId: FloorId) = 
    sum sId: SlotId . (toFloor(sId)==pId) -> (
    		rcvItemStoreCmd(sId) . goToInputLift(pId) . rcvItemPickerFromLift(sId) . goToSlot(pId, sId) . storeItemToSlot(toFloor(sId), sId) . Picker(pId) +
            rcvItemCollectCmd(sId) . goToSlot(pId, sId) .  collectItemFromSlot(toFloor(sId), sId) . goToOutputLift(pId) . sendItemPickerToLift(sId) . Picker(pId)
	);

% STORAGE CONTROLLER
act 
    rcvStoreReq: SlotId; % the slot is chosen by the storage
	rcvCollectReq : SlotId;  % the slot is requested by the scanner
	sendStoreReqOK, sendStoreReqKO, sendCollectReqOK, sendCollectReqKO: SlotId;

% ------------ TODO: check whether you can get rid of n and use the FSet only ------------------
proc Storage(n: Int, slots: FSet(SlotId))  =
	sum sId: SlotId . (
		rcvCollectReq(sId) .
		    (sId in slots) -> sendCollectReqOK(sId) . Storage(n-1, remove_item(sId, slots))
       				               <> sendCollectReqKO(sId) . Storage(n, slots)
		+
		rcvStoreReq(sId) .
			(!(sId in slots) && (n<cap)) -> sendStoreReqOK(sId) . Storage(n+1, add_item(sId, slots))
            			  <> sendStoreReqKO(sId) . Storage(n, slots)
	);

act safeTransferB2L, safeTransferL2B, safeTransferL2P, safeTransferP2L, safeStoreReq, safeCollectReq,
		safeStore, safeNoStore, safeCollect, safeNoCollect, safePrintTicket, safeScanTicket: SlotId;
		safeMoveLift: Direction # FloorId;
		safePickerMoveToSlot, safePickerCollect, safePickerStore: FloorId # SlotId;
		safePMoveToInLift, safePMoveToOutLift: FloorId;
		triggerEmergency, resetEmergency;

proc EmergencyHandler =
	triggerEmergency . resetEmergency . EmergencyHandler
    +
	sum sId: SlotId, lt: Direction . (
		(
			safeTransferL2B(sId) +	safeTransferL2P(sId) + safeTransferP2L(sId) +
			safeStoreReq(sId) + safeCollectReq(sId) +
			( safeStore(sId) . safePrintTicket(sId) . safeTransferB2L(sId)) +  % this enforces that printTicket will only happen once and right after safeStore, plus the inabilty to start another storeReq with an item still inside
			safeCollect(sId) +  safeNoStore(sId) + safeNoCollect(sId) +
			safeMoveLift(lt, toFloor(sId)) +safeScanTicket(sId) +
			safePickerMoveToSlot(toFloor(sId), sId)  + safePMoveToOutLift(toFloor(sId)) + safePMoveToInLift(toFloor(sId))  + safePickerCollect(toFloor(sId), sId) + safePickerStore(toFloor(sId), sId)
		)
		. EmergencyHandler
	);

act 
	transferItemBufferToLift, transferItemLiftToPicker, transferItemLiftToBuffer, transferItemPickerToLift, collectRequest, storeRequest, ticketScan, ticketPrint: SlotId;
    moveLift: Direction # FloorId;
    pickerToInputLift, pickerToOutputLift: FloorId;
	movePickerToSlot, pickerCollectItem, pickerStoreItem: FloorId # SlotId;
	storeOK, storeKO, collectOK, collectKO: SlotId;

init
	allow(	{ 
			transferItemBufferToLift, transferItemLiftToPicker, transferItemLiftToBuffer, transferItemPickerToLift,
			pickerToInputLift, pickerToOutputLift, pickerStoreItem, pickerCollectItem, moveLift, triggerEmergency, resetEmergency,
			storeRequest, storeOK, storeKO, collectRequest, collectOK, collectKO, ticketScan, ticketPrint,
			movePickerToSlot
		 },
		comm( {
				% BUFFER						| STORAGE						| LIFT									| PICKER							| PRINTER					| SCANNER						| EMERGENCY							| RESULT
				sendItemBufferToLift 												| rcvItemLiftFromBuffer 																															| safeTransferB2L					-> transferItemBufferToLift,
														   											   sendItemLiftToPicker 	| rcvItemPickerFromLift 																				| safeTransferL2P					-> transferItemLiftToPicker,
				rcvItemBufferFromLift																						| sendItemLiftToBuffer 																					| safeTransferL2B					-> transferItemLiftToBuffer,
																									   rcvItemLiftFromPicker | sendItemPickerToLift 																					| safeTransferP2L					-> transferItemPickerToLift,
															rcvStoreReq																											| sendItemStoreReq  											| safeStoreReq							-> storeRequest,
				itemUserInOK				 | sendStoreReqOK			| itemStoreOK					| rcvItemStoreCmd			| rcvItemStoreOK   												| safeStore								-> storeOK,
				itemUserInKO				 | sendStoreReqKO 			| itemStoreKO																| rcvItemStoreKO													| safeNoStore							-> storeKO,
															rcvCollectReq 																																			| sendItemCollectReq 	| safeCollectReq						-> collectRequest,
				itemUserOutOK			 | sendCollectReqOK 		| itemCollectOK				| rcvItemCollectCmd 											| rcvItemCollectOK			| safeCollect								-> collectOK,
				itemUserOutKO			 | sendCollectReqKO 		| itemCollectKO																								| rcvItemCollectKO 			| safeNoCollect						-> collectKO,
																									   moveToFloor																																			 	| safeMoveLift							-> moveLift,
																																															  printTicket														 	| safePrintTicket						-> ticketPrint,
																																																								  scanTicket					 	| safeScanTicket						-> ticketScan,
																																				  goToSlot																										 	| safePickerMoveToSlot			-> movePickerToSlot,
																																				  goToInputLift																								 	| safePMoveToInLift				-> pickerToInputLift,
																																				  goToOutputLift																							 	| safePMoveToOutLift				-> pickerToOutputLift,
																																				  storeItemToSlot																							 	| safePickerStore						-> pickerStoreItem,
																																				  collectItemFromSlot																					 	| safePickerCollect					-> pickerCollectItem
				% there are missing synchronization safe actions for moving a picker to the output/input  lift, but maybe that is a design choice so that the picker goes to safety after an emergency has triggered
			},
			Buffer(input) || Buffer(output) || Lift(input) || Lift(output)  || Picker(f0) || Picker(f1) || Storage(0, {}) || Printer || Scanner || EmergencyHandler
		)
	);




