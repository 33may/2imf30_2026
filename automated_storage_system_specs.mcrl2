sort
    % Use a finite struct type for slots and tickets to avoid infinite state space.
    % the system has 6 total slots, 3 per floor, while floor 0 is only for item entry/exit
    SlotId = struct s0 | s1 | s2 | s3 ;
	FloorId = struct f0 | f1 | f2;
    Direction = struct input | output;
    Mode = struct normal | emergency;

map
    cap: Nat;
    slot_info: SlotId -> FloorId;
    add_item: SlotId # FSet(SlotId) -> FSet(SlotId);
    remove_item: SlotId # FSet(SlotId) -> FSet(SlotId);

var
    fn: FloorId;
    ps: SlotId;
	occupiedSlots: FSet(SlotId);
eqn
    cap = 4;
    slot_info(s0) = f0; slot_info(s1) = f0;
    slot_info(s2) = f1; slot_info(s3) = f1;
%    slot_info(s4) = f2; slot_info(s5) = f2;
    add_item(ps, occupiedSlots) = occupiedSlots + {ps};
    remove_item(ps, occupiedSlots) = occupiedSlots - {ps};

% LIFT CONTROLLER
act
    moveToFloor: FloorId;
	rcvItemLiftFromPicker, sendItemLiftToPicker, rcvItemLiftFromBuffer, sendItemLiftToBuffer: SlotId;
	itemCollectOK, itemStoreOK, itemStoreKO, itemCollectKO: SlotId;

% --------------------------TODO you can probably get rid of the current floor -----------------------------
proc Lift(lt: Direction, cf: FloorId) =
	sum sId: SlotId . (
	    (lt == output) -> ( (itemCollectOK(sId) . moveToFloor(slot_info(sId)) . rcvItemLiftFromPicker(sId) . moveToFloor(f0) . sendItemLiftToBuffer(sId) . Lift(lt, cf)) +
										(itemCollectKO(sId) . Lift(lt, cf)) )
		+
    	(lt == input) -> ( ( itemStoreOK(sId) . rcvItemLiftFromBuffer(sId) . moveToFloor(slot_info(sId)) . sendItemLiftToPicker(sId) . moveToFloor(f0) . Lift(lt, cf)) +
									itemStoreKO(sId) . Lift(lt, cf) )
	);
% BUFFER CONTROLLER
act
	itemUserInOK,itemUserInKO, itemUserOutKO , itemUserOutOK, itemUserOut: SlotId;
	sendItemBufferToLift: SlotId; %the item is destined for this slotId
	rcvItemBufferFromLift: SlotId; %the item is coming from this slotId

proc Buffer(bt: Direction) =
	sum sId: SlotId . (
	    (bt == input) -> (itemUserInOK(sId) . (sendItemBufferToLift(sId)) . Buffer(bt) + 
									itemUserInKO(sId) . Buffer(bt))
		+
    	(bt == output) -> (itemUserOutOK(sId) . rcvItemBufferFromLift(sId) . itemUserOut(sId) . Buffer(bt) +
									itemUserOutKO(sId) . Buffer(bt))
	);
% SCANNER CONTROLLER
act scanTicket: SlotId;
	sendItemCollectReq: SlotId;
	rcvItemCollectOK, rcvItemCollectKO: SlotId;
    ticketOK: SlotId; % valid ticket presented
    ticketKO: SlotId; % invaldi ticket presented;

proc Scanner = 
    sum sId: SlotId . scanTicket(sId) . sendItemCollectReq(sId) .
        ( (rcvItemCollectOK(sId) . ticketOK(sId) . Scanner) +
          (rcvItemCollectKO(sId) . ticketKO(sId) . Scanner));

% PRINTER CONTROLLER
act printTicket: SlotId;
    sendItemStoreReq;
	rcvItemStoreOK, rcvItemStoreKO: SlotId;
    itemOKPrint, itemKOPrint;

proc Printer =
	sendItemStoreReq .  sum sId: SlotId . 
        ( (rcvItemStoreOK(sId) . printTicket(sId) . Printer) +
          (rcvItemStoreKO(sId) . Printer) );

% PICKER CONTROLLER
act rcvItemPickerFromLift, sendItemPickerToLift, goToSlot, rcvItemCollectCmd, rcvItemStoreCmd, storeItemToSlot, collectItemFromSlot: SlotId;
		goToInputLift, goToOutputLift;

proc Picker(pId: FloorId) = 
    sum sId: SlotId . (slot_info(sId)==pId) -> (
    		rcvItemStoreCmd(sId) . goToInputLift . rcvItemPickerFromLift(sId) . goToSlot(sId) . storeItemToSlot(sId) . goToInputLift . Picker(pId) +
            rcvItemCollectCmd(sId) . goToSlot(sId) .  collectItemFromSlot(sId) . goToOutputLift . sendItemPickerToLift(sId) . Picker(pId)
	);

% STORAGE CONTROLLER
act 
    rcvStoreReq; % the slot is chosen by the storage
	rcvCollectReq : SlotId;  % the slot is requested by the scanner
	sendStoreReqOK, sendStoreReqKO, sendCollectReqOK, sendCollectReqKO: SlotId;

% ------------ TODO: check whether you can get rid of n and use the FSet only ------------------
proc Storage(n: Int, slots: FSet(SlotId))  =
	sum sId: SlotId . (
		rcvCollectReq(sId) .
		    (sId in slots) -> sendCollectReqOK(sId) . Storage(n-1, remove_item(sId, slots))
       				               <> sendCollectReqKO(sId) . Storage(n, slots)
		+
		rcvStoreReq .
			(!(sId in slots) && (n<cap)) -> sendStoreReqOK(sId) . Storage(n+1, add_item(sId, slots))
            			  <> sendStoreReqKO(sId) . Storage(n, slots)
	);
 
% ----------------------TODO: EMERGENCY CONTROLLER----------------------------------------

act 
	transferItemBufferToLift, transferItemLiftToPicker, transferItemLiftToBuffer, transferItemPickerToLift, collectRequest: SlotId;
	storeOK, storeKO, collectOK, collectKO: SlotId;
	storeRequest;

init
	allow(	{ 
			transferItemBufferToLift, transferItemLiftToPicker, transferItemLiftToBuffer, transferItemPickerToLift,
			goToSlot, goToInputLift, goToOutputLift, storeItemToSlot, collectItemFromSlot, moveToFloor,
			storeRequest, storeOK, storeKO, collectRequest, collectOK, collectKO, printTicket, scanTicket, itemUserOut, ticketOK, ticketKO
		 },
		comm( {
				% BUFFER						| STORAGE						| LIFT									| PICKER							| PRINTER					| SCANNER						| RESULT
				sendItemBufferToLift 												| rcvItemLiftFromBuffer 																															-> transferItemBufferToLift,
														   											   sendItemLiftToPicker 	| rcvItemPickerFromLift 																				-> transferItemLiftToPicker,
				rcvItemBufferFromLift																						| sendItemLiftToBuffer 																					-> transferItemLiftToBuffer,
																									   rcvItemLiftFromPicker | sendItemPickerToLift 																					-> transferItemPickerToLift,
															rcvStoreReq																											| sendItemStoreReq  											-> storeRequest,
				itemUserInOK				 | sendStoreReqOK			| itemStoreOK					| rcvItemStoreCmd			| rcvItemStoreOK   												-> storeOK,
														    sendStoreReqKO 			| itemStoreKO																| rcvItemStoreKO													-> storeKO,
															rcvCollectReq 																																			| sendItemCollectReq 	-> collectRequest,
				itemUserOutOK			 | sendCollectReqOK 		| itemCollectOK				| rcvItemCollectCmd 											| rcvItemCollectOK			-> collectOK,
				 											sendCollectReqKO 		| itemCollectKO																								| rcvItemCollectKO 			-> collectKO
			},
			Buffer(input) || Buffer(output) || Lift(input, f0) || Lift(output, f0)  || Picker(f0) || Picker(f1) || Storage(0, {}) || Printer || Scanner
		)
	);




