map numFloors, slotsPerFloor : Pos;
    numSlots: Nat;

eqn numFloors = 1;
    slotsPerFloor = 1;
    numSlots = numFloors * slotsPerFloor;

sort Item = struct hasItem | noItem;

sort LiftType = struct inputLift | outputLift;

sort Slot = struct slot(fl: Nat, sp: Nat);
    SlotState = struct free | pending | stored;
    Storage   = Slot -> SlotState;

act liftItemFromPicker, liftItemToPicker, liftItemFromBuffer, liftItemToBuffer, moveToFloor : Nat # LiftType;

proc Lift(F: Nat, I: Item, T: LiftType) =
    (I == noItem) -> liftItemFromPicker(F, T).Lift(F, hasItem, T) +
    (I == hasItem) -> liftItemToPicker(F, T).Lift(F, noItem, T) +
    (I == noItem && F == 0) -> liftItemFromBuffer(F, T).Lift(F, hasItem, T) +
    (I == hasItem && F == 0) -> liftItemToBuffer(F, T).Lift(F, noItem, T) +
    sum f: Nat . (f > 0 && f < numFloors && f != F) -> moveToFloor(f, T).Lift(f, I, T);

act itemInUser, itemOutUser, inputBufferLock, inputBufferUnlock;
    bufferState : Item;
    bufferToLift, bufferFromLift : Nat # LiftType;

proc
    InputBuffer(I: Item, locked: Bool) =
        bufferState(I) . InputBuffer(I, locked) +
        inputBufferLock . InputBuffer(I, true) +
        inputBufferUnlock . InputBuffer(I, false) +
        (!locked && I == noItem)
            -> itemInUser . InputBuffer(hasItem, locked) +
        (locked && I == hasItem)
            -> bufferToLift(0, inputLift) . InputBuffer(noItem, locked);

    OutputBuffer(I: Item) = (I == noItem)
        -> bufferFromLift(0, outputLift) . OutputBuffer(hasItem)
        <> itemOutUser . OutputBuffer(noItem);

act printTicket, scanTicket : Slot;

proc Scanner =
    sum F: Nat . (F < numFloors) ->
    sum S: Nat . (S < slotsPerFloor) ->
        scanTicket(slot(F, S)) . Scanner;

proc Printer =
    sum F: Nat . (F < numFloors) ->
    sum S: Nat . (S < slotsPerFloor) ->
        printTicket(slot(F, S)) . Printer;

sort PickerLoc = struct atSlot (slotNr: Nat) ? isAtSlot | atLift (liftType: LiftType) ? isAtLift;

act pickerGoToLift, pickerItemToLift, pickerItemFromLift : Nat # LiftType; % floor nr x lift
    pickerGoToSlot : Nat;
    pickerItemToSlot, pickerItemFromSlot : Slot;

proc Picker(F: Nat, I: Item, L: PickerLoc) =
    pickerGoToLift(F, outputLift) . Picker(F, I, atLift(outputLift))
    + pickerGoToLift(F, inputLift) . Picker(F, I, atLift(inputLift))
    + sum S: Nat . (S < slotsPerFloor) -> pickerGoToSlot(S) . Picker(F, I, atSlot(S))
    + isAtSlot(L) -> (
        (I == hasItem) -> pickerItemToSlot(slot(F, slotNr(L))) . Picker(F, noItem, L)
                       <> pickerItemFromSlot(slot(F, slotNr(L))) . Picker(F, hasItem, L)
    )
    + isAtLift(L) -> (
        ((liftType(L) == inputLift) && (I == noItem)) -> pickerItemFromLift(F, inputLift) . Picker(F, hasItem, L)
        + ((liftType(L) == outputLift) && (I == hasItem)) -> pickerItemToLift(F, outputLift) . Picker(F, noItem, L)
    );


% ---------------------------------------------------------------
% Storage data

map slotAt        : Nat -> Slot;
    countFree     : Storage # Nat -> Nat;
    isFull        : Storage -> Bool;
    firstFreeFrom : Storage # Nat -> Slot;
    chooseSlot    : Storage -> Slot;

var i: Nat; st: Storage;
eqn slotAt(i) = slot(i div slotsPerFloor, i mod slotsPerFloor);
    i == numSlots -> countFree(st, i) = 0;
    i < numSlots -> countFree(st, i) = if(st(slotAt(i)) == free, 1, 0) + countFree(st, i + 1);
    isFull(st) = countFree(st, 0) == 0;
    i < numSlots -> firstFreeFrom(st, i) = if(st(slotAt(i)) == free, slotAt(i), firstFreeFrom(st, i + 1));
    chooseSlot(st) = firstFreeFrom(st, 0);

% ---------------------------------------------------------------
% Storage process

act storageFull;
    canStoreSlot, canFetchSlot, promiseSlot, completeSlot, takeFromSlot : Slot;

proc Storage(st: Storage) =
    isFull(st) -> storageFull . Storage(st) +
    sum F: Nat . (F < numFloors) ->
    sum S: Nat . (S < slotsPerFloor) -> (
        (st(slot(F, S)) == free) -> (
            promiseSlot(slot(F, S)) . Storage(st[slot(F, S) -> pending])
            + canStoreSlot(slot(F, S)) . Storage(st)
        ) +
        (st(slot(F, S)) == pending) -> completeSlot(slot(F, S)) . Storage(st[slot(F, S) -> stored]) +
        (st(slot(F, S)) == stored) -> (
            takeFromSlot(slot(F, S)) . Storage(st[slot(F, S) -> free])
            + canFetchSlot(slot(F, S)) . Storage(st)
        )
    );

act startPress;
    startScanTicket : Slot;

    showErrorNoItem, showErrorStorageFull, unlockInputBuffer;

    checkBufferState : Item;
    reserveSlotForNewItem, checkSlotHasItem : Slot;

    transferBufferToLift, transferLiftToBuffer,
    transferLiftToPicker, transferPickerToLift : Nat # LiftType;

    transferPickerToSlot, transferSlotToPicker : Slot;

act ctrStoreBegin, ctrStorageFull, ctrUnlockInput, ctrFetchReset;
    ctrBufferCheck : Item;
    ctrReserveSlot, ctrFetchBegin, ctrItemExists, ctrItemNotExists, ctrItemStored : Slot;
    ctrItemFetched, ctrInItemLift, ctrInItemFloor : Nat # LiftType;

proc ControllerStoreSequence =
    ctrStoreBegin . (
        (ctrBufferCheck(noItem) . showErrorNoItem . ctrUnlockInput) +
        (ctrBufferCheck(hasItem) . (
              ctrStorageFull . ctrUnlockInput
            + sum F: Nat . (F < numFloors) ->
              sum S: Nat . (S < slotsPerFloor) ->
                    ctrReserveSlot(slot(F, S))
                  . ctrInItemLift(0, inputLift)
                  . ctrInItemFloor(F, inputLift)
                  . ctrItemStored(slot(F, S))))
    );

proc ControllerFetchSequence =
    sum F: Nat . (F < numFloors) ->
    sum S: Nat . (S < slotsPerFloor) ->
        ctrFetchBegin(slot(F, S)) . (
            (ctrItemExists(slot(F, S)) . ctrItemFetched(0, outputLift)) +
            (ctrItemNotExists(slot(F, S)) . ctrFetchReset)
        );

proc Controller = (ControllerStoreSequence + ControllerFetchSequence) . Controller;

proc FullModel = allow(
    {
        itemInUser,
        itemOutUser,
        startPress,
        startScanTicket,
        showErrorNoItem,
        showErrorStorageFull,
        unlockInputBuffer,
        reserveSlotForNewItem,
        checkBufferState,
        checkSlotHasItem,
        transferBufferToLift,
        transferLiftToBuffer,
        transferLiftToPicker,
        transferPickerToLift,
        transferPickerToSlot,
        transferSlotToPicker,
        pickerGoToSlot,
        pickerGoToLift,
        moveToFloor
    },
    comm(
        {
            ctrStoreBegin | inputBufferLock -> startPress,
            ctrFetchBegin | scanTicket -> startScanTicket,

            ctrBufferCheck | bufferState -> checkBufferState,
            ctrUnlockInput | inputBufferUnlock -> unlockInputBuffer,
            ctrStorageFull | storageFull -> showErrorStorageFull,

            ctrReserveSlot | printTicket | promiseSlot -> reserveSlotForNewItem,
            ctrItemNotExists | canStoreSlot -> checkSlotHasItem,
            ctrItemExists | canFetchSlot -> checkSlotHasItem,

            ctrInItemLift | bufferToLift | liftItemFromBuffer -> transferBufferToLift,

            ctrInItemFloor | liftItemToPicker | pickerItemFromLift -> transferLiftToPicker,
            liftItemFromPicker | pickerItemToLift -> transferPickerToLift,

            pickerItemFromSlot | takeFromSlot -> transferSlotToPicker,

            ctrItemStored | pickerItemToSlot | completeSlot -> transferPickerToSlot,
            ctrItemFetched | bufferFromLift | liftItemToBuffer -> transferLiftToBuffer
        },
        (
            Controller
            || Storage(lambda s: Slot . free)
            || InputBuffer(noItem, false)
            || OutputBuffer(noItem)
            || Printer
            || Scanner
            || Lift(0, noItem, inputLift)
            || Lift(0, noItem, outputLift)
            || Picker(0, noItem, atSlot(0))
        )
    )
);

init hide({ pickerGoToSlot, pickerGoToLift, moveToFloor }, FullModel);
