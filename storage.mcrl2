sort
    % Use a finite struct type for slots and tickets to avoid infinite state space.
    % the system has 6 total slots, 3 per floor, while floor 0 is only for item entry/exit
    SlotId = struct s0 | s1 | s2 | s3;
	FloorId = struct f0 | f1 | f2;
    PickerId = struct p1 | p2;
    LiftType = struct input | output;
    BufferType = struct input | output;
    Mode = struct normal | emergency;

map
    cap: Nat;
    slot_info: SlotId -> FloorId;
    occupiedSlots: SlotId # FSet(SlotId) -> FSet(SlotId);

var
    fn: FloorId;
    ps: SlotId;

eqn
    cap = 4;
    slot_info(s0) = f1;
    slot_info(s1) = f1;
    slot_info(s2) = f1;
    slot_info(s3) = f2;
    add_item(slotId, occupiedSlots) = occupiedSlots + {slotId};
    remove_item(slotId, occupiedSlots) = occupiedSlots - {slotId};

% LIFT CONTROLLER

act
    moveToFloor: FloorId;
    pickupItem, dropOffItem;

proc LiftController(lt: LiftType, hasItem: Bool, cf: FloorId) = 
    sum f: FloorId . (f != cf) -> moveToFloor(f) . LiftController(lt, hasItem, f) +
    (!hasItem && lt == output && cf != f0) -> pickupItem . LiftController(lt, true, cf) +
    (hasItem && lt == output && cf == f0) -> dropOffItem . LiftController(lt, false, cf) +
    (!hasItem && lt == input && cf == f0) -> pickupItem . LiftController(lt, true, cf) +
    (hasItem && lt == input && cf != f0) -> dropOffItem . LiftController(lt, false, cf)

% BUFFER CONTROLLER

act itemInUser, itemOutUser, itemInLift, itemOutLift;

proc BufferController(bt: BufferType, hasItem: Bool) =
    ((bt == input && !hasItem) -> itemInUser . BufferController(bt, true)) +
    ((bt == input && hasItem) -> itemOutLift . BufferController(bt, false)) +
    ((bt == output && !hasItem) -> itemInLift . BufferController(bt, true)) +
    ((bt == outout && hasItem) -> itemOutUser . BufferController(bt, false))

% PICKER CONTROLLER

act collectFromLift, giveToLift, goToInputLift, goToOutputLift, goToSlot, storeItemToSlot, collectItemFromSlot: SlotId;

proc PickerController(pID: PickerId, hasItem: Bool) = 
    sum sId: SlotId .
    (!hasItem) -> goToSlot(sId) .
                  collectItemFromSlot(sId) .
                  goToInputLifts(sId) .
                  collectFromLift(sId) . PickerController(pID, true)
               <> goToSlot(sId) .
                  storeItemToSlot(sId) .
                  goToOutputLift(sId) .
                  giveToLift(sId) . PickerController(pID, false)

% SCANNER CONTROLLER

act scanTicket: SlotId;
    ticketOK; % valid ticket presented
    ticketKO; % invaldi ticket presented;

proc ScannerController = 
    sum sId: SlotId .
        ( (ticketOK . scanTicket(sId) . ScannerController) +
          (ticketKO . ScannerController)

% PRINTER CONTROLLER

act printTicket: SlotId;
    itemKO; % item presented can not be stored
    itemOK; % item presented can be stored;

proc PrinterController =
    sum sId: SlotId .
        ( (itemOK . printTicket(sId) . PrinterController) +
          (itemKO . PrinterController) )

% STORAGE CONTROLLER

act slotOK, noSlots;
    storeOK: SlotId;
    receiveStoreCmd, receiveCollectCmd : SlotId;
    addItem, removeItem: SlotId;

proc StorageController(n: Nat, slots: FSet(SlotId))  =
    (n < cap && n > 0) ->
        sum sId: SlotId .
            (sId in slots) -> receiveCollectCmd(sId) . collectOK(sId) . StorageController(n-1, remove_item(s_id, slots))
                           <> receiveStoreCmd(sId) . storeOK(sId) . StorageController(n+1, add_item(sId, slots))
    (n == cap) ->        
        sum sId: SlotId . receiveCollectCmd(sId) . storeOK(sId) . StorageController(n-1, remove_item(sId, slots))
    (n == 0) ->
        sum sId: SlotId . receiveStoreCmd(sId) . storeOK(sId) . StorageController(n+1, add_item(sId, slots))

% EMERGENCY CONTROLLER

init StartButton
  || InputBuffer(noItem) || OutputBuffer(noItem)
  || Printer || Scanner
  || Lift(0, noItem, inputLift)
  || Lift(0, noItem, outputLift)
  || Picker(0, noItem, atSlot(0))
  || Picker(1, noItem, atSlot(0));




